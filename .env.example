# For Render, use your MongoDB Atlas mongodb+srv:// connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/student-consultancy-safety
JWT_SECRET=replace-with-a-long-random-secret
# Set this to the deployed frontend origin, without a trailing slash.
CLIENT_URL=http://localhost:5173
PORT=5001
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM="Dream Chaser <your-email@example.com>"
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-app-password
