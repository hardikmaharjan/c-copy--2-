# For Render, use your MongoDB Atlas mongodb+srv:// connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/student-consultancy-safety
JWT_SECRET=replace-with-a-long-random-secret
# Set this to the deployed frontend origin, without a trailing slash.
CLIENT_URL=http://localhost:5173
PORT=5001
# Create this at resend.com. Keep it secret and do not commit it.
RESEND_API_KEY=re_your_resend_api_key
# Use a sender address from a domain you verified in Resend.
RESEND_FROM="Dream Chaser <no-reply@yourdomain.com>"
